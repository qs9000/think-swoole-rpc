# ========================================
# RPC 客户端环境变量配置示例
# 
# 复制此文件为 .env 并根据实际环境修改配置值
# ========================================

# ----------------------------------------
# 注册中心配置 (Registry)
# ----------------------------------------
RPC_REGISTRY_ENABLE=true
RPC_REGISTRY_HOST=127.0.0.1
RPC_REGISTRY_PORT=9500
RPC_REGISTRY_TIMEOUT=5000
RPC_REGISTRY_CONNECT_TIMEOUT=1000
RPC_HEARTBEAT_INTERVAL=30
RPC_REGISTRY_TOKEN=

# ----------------------------------------
# 服务发现配置 (Service Discovery)
# ----------------------------------------
RPC_LOADBALANCER=random
RPC_CACHE_TTL=30
RPC_ENABLE_GRACEFUL_DEGRADATION=true
RPC_HEALTH_CHECK_ENABLED=true

# ----------------------------------------
# 熔断器配置 (Circuit Breaker)
# ----------------------------------------
RPC_CIRCUIT_FAILURE_THRESHOLD=5
RPC_CIRCUIT_SUCCESS_THRESHOLD=3
RPC_CIRCUIT_TIMEOUT=60
RPC_CIRCUIT_REQUEST_TIMEOUT=5000

# ----------------------------------------
# RPC 调用配置 (Call Configuration)
# ----------------------------------------
RPC_TIMEOUT=5
RPC_RETRIES=2
RPC_BACKOFF_BASE=100
RPC_BACKOFF_MAX=1000

# ----------------------------------------
# 连接池配置
# ----------------------------------------
RPC_MAX_CONNECTIONS=20
RPC_CONNECT_TIMEOUT=1
RPC_MIN_CONNECTIONS=1
RPC_IDLE_TIMEOUT=300
RPC_HEALTH_CHECK_INTERVAL=60
RPC_ENABLE_CONNECTION_POOL=true

# ----------------------------------------
# 协议配置 (Protocol)
# ----------------------------------------
RPC_PROTOCOL_FORMAT=json
RPC_PACKAGE_EOF=\r\n
RPC_OPEN_EOF_CHECK=true

# ----------------------------------------
# 日志与调试配置 (Logging & Debug)
# ----------------------------------------
RPC_DEBUG=false
RPC_LOG_LEVEL=error
RPC_LOG_CIRCUIT_BREAKER=true
RPC_LOG_SERVICE_DISCOVERY=false
RPC_LOG_CONNECTION_POOL=false

# ----------------------------------------
# 监控配置 (Monitoring)
# ----------------------------------------
RPC_MONITORING_ENABLED=false
RPC_MONITORING_INTERVAL=60
RPC_MONITORING_ENDPOINT=

# ----------------------------------------
# 安全配置
# ----------------------------------------
RPC_ENABLE_TLS=false
RPC_TLS_VERIFY_PEER=true
RPC_REQUEST_SIGNING=false
RPC_SIGNING_ALGORITHM=HMAC-SHA256
RPC_SECRET_KEY=your-secret-key-here
RPC_ALLOWED_IPS=
RPC_RATE_LIMIT_ENABLED=false
RPC_RATE_LIMIT_REQUESTS=1000
RPC_RATE_LIMIT_PERIOD=60

# ----------------------------------------
# 性能优化配置
# ----------------------------------------
RPC_ENABLE_PROTOCOL_CACHE=true
RPC_PROTOCOL_CACHE_TTL=3600
RPC_ENABLE_BATCH_DISCOVERY=false
RPC_BATCH_DISCOVERY_SIZE=10
RPC_ENABLE_ASYNC_HEARTBEAT=true
RPC_CONNECTION_WARMUP=false
RPC_WARMUP_CONNECTIONS=5

# ----------------------------------------
# 接口绑定配置 (Interface Binding)
# ----------------------------------------
RPC_INTERFACES_FILE=rpc.php
RPC_AUTO_BIND_INTERFACES=true
